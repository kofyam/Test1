rules_version = '2';

// Security rules for the meal-order site. Paste into Firebase console ->
// Firestore Database -> Rules, and Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'minerminer404@gmail.com';
    }

    function currentWeek() {
      return get(/databases/$(database)/documents/config/current).data.weekId;
    }

    // Anyone with the link can read the menus and settings; only the admin can change them.
    match /menus/{week} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{name} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Employees save their own order for the active week; only the admin can delete orders.
    match /orders/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['weekId', 'name', 'picks', 'updatedAt'])
        && request.resource.data.weekId is string
        && request.resource.data.weekId == currentWeek()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.picks is list
        && request.resource.data.picks.size() <= 5
        && request.resource.data.updatedAt is string
        && id.matches('o_' + request.resource.data.weekId + '_[0-9a-f]{2,240}')
      );
      allow delete: if isAdmin();
    }
  }
}
